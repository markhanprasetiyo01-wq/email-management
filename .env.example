# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal, 
# atau masukkan variabel berikut ke Dashboard Vercel > Settings > Environment Variables.

# 1. Upstash Redis (Cloud Database)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# 2. Layanan Pengiriman Email Resmi (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Game & Email Hub <noreply@mail.yourdomain.com>"
APP_URL="https://gamemail.yourdomain.com"

# 3. Cadangan SMTP Gmail (Opsional jika Resend tidak aktif)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASS="your-app-password"

# 4. Whitelist IP Pengembang (Bebas dari batasan 1 Akun 1 IP)
# Pisahkan dengan koma jika ada beberapa IP: contoh: "123.456.78.90, 114.122.x.x"
ADMIN_WHITELIST_IPS="123.456.78.90"
